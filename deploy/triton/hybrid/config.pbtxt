name: "hybrid"
platform: "onnxruntime_onnx"
max_batch_size: 32
input [{ name: "locs" data_type: TYPE_FP32 dims: [ -1, 2 ] } { name: "distance_matrix" data_type: TYPE_FP32 dims: [ -1, -1 ] }]
output [{ name: "reward" data_type: TYPE_FP32 dims: [ 1 ] }]
instance_group [{ count: 2 kind: KIND_GPU }]
dynamic_batching { preferred_batch_size: [ 8, 16, 32 ] max_queue_delay_microseconds: 100 }
# Fallback: ORT INT8 (SmoothQuant) if TensorRT unavailable; set optimization { execution_accelerators { gpu_execution_accelerator: [{ name: "tensorrt" parameters { key: "precision_mode" value: "FP16" } }] } } or remove for pure ORT
optimization { execution_accelerators { gpu_execution_accelerator: [{ name: "tensorrt" } { name: "ort" }] } }
